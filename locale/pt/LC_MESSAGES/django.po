msgstr "Público"

msgid "Open GM Cockpit"
msgstr "Abrir Cabine do Mestre"

msgid "Return as %(name)s"
msgstr "Voltar como %(name)s"

msgid "Enter Room"
msgstr "Entrar na Sala"

msgid "No Active Lupus Games Right Now"
msgstr "Nenhum Jogo Ativo de Lupus no Momento"

msgid "Rooms are created on demand and stay active for 24 hours. Start a new game session and invite your group!"
msgstr "As salas são criadas sob demanda e ficam ativas por 24 horas. Inicie uma nova sessão de jogo e convide o seu grupo!"

msgid "Create the First Lupus Room"
msgstr "Criar a Primeira Sala de Lupus"

msgid "Past & Finished Games"
msgstr "Jogos Anteriores & Terminados"

msgid "Replay"
msgstr "Repetição"

