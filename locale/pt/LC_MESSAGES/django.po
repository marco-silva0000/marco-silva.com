msgstr "🎨 Emojinary"

msgid "Lupus in Tabula - Active Rooms & Game Hub"
msgstr "Lupus in Tabula - Salas Ativas & Central de Jogo"

msgid "+ Create Room"
msgstr "+ Criar Sala"

msgid "All Games"
msgstr "Todos os Jogos"

msgid "Table-first Werewolf & Mafia party game. Zero account logins required. Each player uses their phone for secret roles and voting while you run the room as Game Master."
msgstr "Jogo de festa estilo Lobisomem e Máfia para mesa. Sem contas ou registos. Cada jogador usa o seu telemóvel para papéis secretos e votações enquanto você coordena o jogo como Mestre."

msgid "Join with Room Code"
msgstr "Entrar com Código de Sala"

msgid "Have an 8-character code from your Game Master? Enter it here to jump straight in:"
msgstr "Tem um código de 8 caracteres do seu Mestre? Introduza-o aqui para entrar imediatamente:"

msgid "Join Game"
msgstr "Entrar no Jogo"

msgid "Active Lupus Rooms"
msgstr "Salas Ativas de Lupus"

msgid "+ New Game"
msgstr "+ Novo Jogo"

msgid "CODE"
msgstr "CÓDIGO"

msgid "GM"
msgstr "Mestre"

msgid "alive"
msgstr "vivos"

