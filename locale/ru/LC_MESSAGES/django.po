msgstr "+ Создать комнату"

msgid "All Games"
msgstr "Все игры"

msgid "Table-first Werewolf & Mafia party game. Zero account logins required. Each player uses their phone for secret roles and voting while you run the room as Game Master."
msgstr "Настольная игра для компании в стиле Мафия и Оборотни. Без аккаунтов. Каждый игрок использует телефон для тайных ролей и голосований, пока вы управляете партией в роли Ведущего."

msgid "Join with Room Code"
msgstr "Войти по коду комнаты"

msgid "Have an 8-character code from your Game Master? Enter it here to jump straight in:"
msgstr "Есть 8-значный код от Ведущего? Введите его здесь, чтобы сразу присоединиться:"

msgid "Join Game"
msgstr "Войти в игру"

msgid "Active Lupus Rooms"
msgstr "Активные комнаты Lupus"

msgid "+ New Game"
msgstr "+ Новая игра"

msgid "CODE"
msgstr "КОД"

msgid "GM"
msgstr "Ведущий"

msgid "alive"
msgstr "в живых"

msgid "Password"
msgstr "Пароль"

msgid "Public"
msgstr "Открытая"

msgid "Open GM Cockpit"
msgstr "Открыть пульт ведущего"

msgid "Return as %(name)s"
msgstr "Вернуться как %(name)s"

msgid "Enter Room"
msgstr "Войти в комнату"

msgid "No Active Lupus Games Right Now"
msgstr "Сейчас нет активных игр Lupus"

msgid "Rooms are created on demand and stay active for 24 hours. Start a new game session and invite your group!"
msgstr "Комнаты создаются по запросу и активны 24 часа. Создайте новую партию и пригласите компанию!"

msgid "Create the First Lupus Room"
msgstr "Создать первую комнату Lupus"

msgid "Past & Finished Games"
msgstr "Прошедшие и завершённые игры"

msgid "Replay"
msgstr "Повтор"

