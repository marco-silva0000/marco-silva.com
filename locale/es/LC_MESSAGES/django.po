msgstr "Reglas de Juego y Temporizadores"

msgid "Discussion Round Timer"
msgstr "Temporizador de Discusión"

msgid "5 Minutes (Standard)"
msgstr "5 Minutos (Estándar)"

msgid "3 Minutes (Fast)"
msgstr "3 Minutos (Rápido)"

msgid "7 Minutes (Deliberate)"
msgstr "7 Minutos (Tranquilo)"

msgid "10 Minutes"
msgstr "10 Minutos"

