msgstr "ಪಾಸ್‌ವರ್ಡ್‌ನಿಂದ ಸಂರಕ್ಷಿಸಲಾಗಿದೆ"

msgid "players"
msgstr "ಆಟಗಾರರು"

msgid "ago"
