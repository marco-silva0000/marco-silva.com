msgstr "+ ಕೊಠಡಿ ರಚಿಸಿ"

msgid "All Games"
msgstr "ಎಲ್ಲಾ ಆಟಗಳು"

msgid "Table-first Werewolf & Mafia party game. Zero account logins required. Each player uses their phone for secret roles and voting while you run the room as Game Master."
msgstr "ಟೇಬಲ್-ಆಧಾರಿತ ತೋಳಮಾನವ ಮತ್ತು ಮಾಫಿಯಾ ಪಾರ್ಟಿ ಆಟ. ಯಾವುದೇ ಲಾಗಿನ್ ಅಗತ್ಯವಿಲ್ಲ. ಪ್ರತಿಯೊಬ್ಬ ಆಟಗಾರನು ರಹಸ್ಯ ಪಾತ್ರಗಳು ಮತ್ತು ಮತದಾನಕ್ಕಾಗಿ ತಮ್ಮ ಫೋನ್ ಬಳಸುತ್ತಾರೆ ಮತ್ತು ನೀವು ಗೇಮ್ ಮಾಸ್ಟರ್ ಆಗಿ ನಡೆಸುತ್ತೀರಿ."

msgid "Join with Room Code"
msgstr "ಕೊಠಡಿ ಕೋಡ್‌ನೊಂದಿಗೆ ಸೇರಿ"

msgid "Have an 8-character code from your Game Master? Enter it here to jump straight in:"
msgstr "ನಿಮ್ಮ ಗೇಮ್ ಮಾಸ್ಟರ್‌ನಿಂದ 8-ಅಕ್ಷರಗಳ ಕೋಡ್ ಹೊಂದಿದ್ದೀರಾ? ನೇರವಾಗಿ ಪ್ರವೇಶಿಸಲು ಇಲ್ಲಿ ನಮೂದಿಸಿ:"

msgid "Join Game"
msgstr "ಆಟಕ್ಕೆ ಸೇರಿ"

msgid "Active Lupus Rooms"
msgstr "ಸಕ್ರಿಯ ಲೂಪಸ್ ಕೊಠಡಿಗಳು"

msgid "+ New Game"
msgstr "+ ಹೊಸ ಆಟ"

msgid "CODE"
msgstr "ಕೋಡ್"

msgid "GM"
msgstr "ಜಿಎಂ"

msgid "alive"
msgstr "ಜೀವಂತ"

msgid "Password"
msgstr "ಪಾಸ್‌ವರ್ಡ್"

msgid "Public"
msgstr "ಸಾರ್ವಜನಿಕ"

msgid "Open GM Cockpit"
msgstr "ಜಿಎಂ ಕಾಕ್‌ಪಿಟ್ ತೆರೆಯಿರಿ"

msgid "Return as %(name)s"
msgstr "%(name)s ಆಗಿ ಹಿಂತಿರುಗಿ"

msgid "Enter Room"
msgstr "ಕೊಠಡಿಗೆ ಪ್ರವೇಶಿಸಿ"

msgid "No Active Lupus Games Right Now"
msgstr "ಪ್ರಸ್ತುತ ಯಾವುದೇ ಸಕ್ರಿಯ ಲೂಪಸ್ ಆಟಗಳಿಲ್ಲ"

msgid "Rooms are created on demand and stay active for 24 hours. Start a new game session and invite your group!"
msgstr "ಕೊಠಡಿಗಳನ್ನು ಅಗತ್ಯವಿದ್ದಾಗ ರಚಿಸಲಾಗುತ್ತದೆ ಮತ್ತು 24 ಗಂಟೆಗಳ ಕಾಲ ಸಕ್ರಿಯವಾಗಿರುತ್ತವೆ. ಹೊಸ ಆಟದ ಸೆಷನ್ ಪ್ರಾರಂಭಿಸಿ ಮತ್ತು ನಿಮ್ಮ ಗುಂಪನ್ನು ಆಹ್ವಾನಿಸಿ!"

msgid "Create the First Lupus Room"
msgstr "ಮೊದಲ ಲೂಪಸ್ ಕೊಠಡಿ ರಚಿಸಿ"

msgid "Past & Finished Games"
msgstr "ಹಿಂದಿನ ಮತ್ತು ಪೂರ್ಣಗೊಂಡ ಆಟಗಳು"

msgid "Replay"
msgstr "ಮರುಪಂದ್ಯ"

msgid "Cockpit"
msgstr "ಕಾಕ್‌ಪಿಟ್"

msgid "Table-First Lupus Highlights"
msgstr "ಟೇಬಲ್-ಆಧಾರಿತ ಲೂಪಸ್ ಮುಖ್ಯಾಂಶಗಳು"

msgid "Hold-to-Peek Secret Roles:"
msgstr "ರಹಸ್ಯ ಪಾತ್ರಗಳನ್ನು ನೋಡಲು ಒತ್ತಿಹಿಡಿಯಿರಿ:"

msgid "Privacy shield keeps cards concealed from prying eyes at the table."
msgstr "ಗೌಪ್ಯತೆ ರಕ್ಷಕವು ಮೇಜಿನ ಮೇಲಿರುವ ಇತರರ ಕಣ್ಣುಗಳಿಂದ ಕಾರ್ಡ್‌ಗಳನ್ನು ರಹಸ್ಯವಾಗಿರಿಸುತ್ತದೆ."

msgid "GM Director Cockpit:"
msgstr "ಜಿಎಂ ನಿರ್ದೇಶಕರ ಕಾಕ್‌ಪಿಟ್:"

msgid "Step-by-step night stages, bluffing calls, and voting manager."
msgstr "ಹಂತ-ಹಂತದ ರಾತ್ರಿ ಹಂತಗಳು, ಬ್ಲಫ್ ಕರೆಗಳು ಮತ್ತು ಮತದಾನ ವ್ಯವಸ್ಥಾಪಕ."

msgid "Town Gazette:"
msgstr "ಟೌನ್ ಗೆಜೆಟ್:"

msgid "Living & fallen players submit morning rumors read aloud at dawn."
msgstr "ಜೀವಂತ ಮತ್ತು ಮೃತ ಆಟಗಾರರು ಮುಂಜಾನೆ ಗಟ್ಟಿಯಾಗಿ ಓದಲಾಗುವ ವದಂತಿಗಳನ್ನು ಕಳುಹಿಸುತ್ತಾರೆ."

msgid "Midgame Arrivals:"
msgstr "ಆಟದ ಮಧ್ಯೆ ಬರುವವರು:"

msgid "Latecomers join as Confirmed Travelers, Town Ghosts, or Successors."
msgstr "ತಡವಾಗಿ ಬಂದವರು ದೃಢೀಕೃತ ಪ್ರಯಾಣಿಕರು, ಪ್ರೇತಗಳು ಅಥವಾ ಉತ್ತರಾಧಿಕಾರಿಗಳಾಗಿ ಸೇರುತ್ತಾರೆ."

msgid "Create Lupus / Werewolf Room"
msgstr "ಲೂಪಸ್ / ತೋಳಮಾನವ ಕೊಠಡಿ ರಚಿಸಿ"

msgid "Back to Active Lupus Rooms"
msgstr "ಸಕ್ರಿಯ ಲೂಪಸ್ ಕೊಠಡಿಗಳಿಗೆ ಹಿಂತಿರುಗಿ"

msgid "Table-first hybrid party game. Zero accounts or logins required. Players join via QR code, and you run the game as Game Master."
msgstr "ಟೇಬಲ್-ಆಧಾರಿತ ಹೈಬ್ರಿಡ್ ಪಾರ್ಟಿ ಆಟ. ಯಾವುದೇ ಖಾತೆ ಅಥವಾ ಲಾಗಿನ್ ಅಗತ್ಯವಿಲ್ಲ. ಆಟಗಾರರು QR ಕೋಡ್ ಮೂಲಕ ಸೇರುತ್ತಾರೆ ಮತ್ತು ನೀವು ಗೇಮ್ ಮಾಸ್ಟರ್ ಆಗಿ ನಡೆಸುತ್ತೀರಿ."

msgid "Room Setup"
msgstr "ಕೊಠಡಿ ಸೆಟಪ್"

msgid "Room Title"
msgstr "ಕೊಠಡಿಯ ಶೀರ್ಷಿಕೆ"

msgid "Game Master Display Name"
msgstr "ಗೇಮ್ ಮಾಸ್ಟರ್ ಪ್ರದರ್ಶನ ಹೆಸರು"

msgid "Room Password (optional)"
msgstr "ಕೊಠಡಿ ಪಾಸ್‌ವರ್ಡ್ (ಐಚ್ಛಿಕ)"

msgid "Leave empty for public join"
msgstr "ಸಾರ್ವಜನಿಕ ಪ್ರವೇಶಕ್ಕಾಗಿ ಖಾಲಿ ಬಿಡಿ"

msgid "If set, joining via QR code will auto-authenticate players automatically. (💡 Demo trick: GM name containing Marco and password test autofills 10 test players for live demo)."
msgstr "ಸೆಟ್ ಮಾಡಿದ್ದರೆ, QR ಕೋಡ್ ಮೂಲಕ ಸೇರಿದಾಗ ಆಟಗಾರರು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ದೃಢೀಕರಿಸಲ್ಪಡುತ್ತಾರೆ. (💡 ಡೆಮೊ ಟ್ರಿಕ್: Marco ಹೊಂದಿರುವ ಜಿಎಂ ಹೆಸರು ಮತ್ತು test ಪಾಸ್‌ವರ್ಡ್ 10 ಟೆಸ್ಟ್ ಆಟಗಾರರನ್ನು ಸೇರಿಸುತ್ತದೆ)."

msgid "Theme & Terms"
msgstr "ಥೀಮ್ ಮತ್ತು ನಿಯಮಗಳು"

msgid "Werewolf / Lupus"
msgstr "ತೋಳಮಾನವ / ಲೂಪಸ್"

msgid "Villagers, Wolves, Seer"
msgstr "ಗ್ರಾಮಸ್ಥರು, ತೋಳಗಳು, ದ್ರಷ್ಟಾರ"

msgid "Mafia"
msgstr "ಮಾಫಿಯಾ"

msgid "Civilians, Mobsters, Cop"
msgstr "ನಾಗರಿಕರು, ದರೋಡೆಕೋರರು, ಪೊಲೀಸ್"

msgid "Game Rules & Timers"
msgstr "ಆಟದ ನಿಯಮಗಳು ಮತ್ತು ಟೈಮರ್‌ಗಳು"

msgid "Discussion Round Timer"
msgstr "ಚರ್ಚಾ ಸುತ್ತಿನ ಟೈಮರ್"

msgid "5 Minutes (Standard)"
msgstr "5 ನಿಮಿಷಗಳು (ಪ್ರಮಾಣಿತ)"

msgid "3 Minutes (Fast)"
msgstr "3 ನಿಮಿಷಗಳು (ವೇಗವಾಗಿ)"

msgid "7 Minutes (Deliberate)"
msgstr "7 ನಿಮಿಷಗಳು (ವಿವರವಾಗಿ)"

msgid "10 Minutes"
msgstr "10 ನಿಮಿಷಗಳು"

msgid "Defense Timer"
msgstr "ರಕ್ಷಣಾ ಟೈಮರ್"

msgid "30 Seconds (Standard)"
msgstr "30 ಸೆಕೆಂಡುಗಳು (ಪ್ರಮಾಣಿತ)"

msgid "45 Seconds"
msgstr "45 ಸೆಕೆಂಡುಗಳು"

msgid "60 Seconds"
msgstr "60 ಸೆಕೆಂಡುಗಳು"

msgid "Limbo & Angel Mechanic:"
msgstr "ಲಿಂಬೋ ಮತ್ತು ದೇವದೂತ ತಂತ್ರ:"

msgid "Slain players enter Limbo once instead of dying directly. If they guess who the Angel is, they are resurrected!"
msgstr "ಕೊಲ್ಲಲ್ಪಟ್ಟ ಆಟಗಾರರು ನೇರವಾಗಿ ಸಾಯುವ ಬದಲು ಒಮ್ಮೆ ಲಿಂಬೋಗೆ ಪ್ರವೇಶಿಸುತ್ತಾರೆ. ಅವರು ದೇವದೂತ ಯಾರೆಂದು ಊಹಿಸಿದರೆ ಪುನರುತ್ಥಾನಗೊಳ್ಳುತ್ತಾರೆ!"

msgid "Staggering Doctor:"
msgstr "ಬದಲಾಗುವ ವೈದ್ಯ:"

msgid "The Doctor / Guard cannot protect the same person two consecutive nights."
msgstr "ವೈದ್ಯ / ಅಂಗರಕ್ಷಕ ಸತತ ಎರಡು ರಾತ್ರಿಗಳಲ್ಲಿ ಒಬ್ಬನೇ ವ್ಯಕ್ತಿಯನ್ನು ರಕ್ಷಿಸುವಂತಿಲ್ಲ."

msgid "Doctor Shields From Sniper:"
msgstr "ವೈದ್ಯ ಸ್ನೈಪರ್‌ನಿಂದ ರಕ್ಷಿಸುತ್ತಾನೆ:"

msgid "If enabled, the Doctor's guard can save a wolf from being shot by the Sniper. (Disabled = sniper penetrates doctor guard)."
msgstr "ಸಕ್ರಿಯಗೊಳಿಸಿದರೆ, ವೈದ್ಯರ ರಕ್ಷಣೆಯು ಸ್ನೈಪರ್ ಗುಂಡಿನಿಂದ ಗುರಿಯನ್ನು ಉಳಿಸಬಹುದು. (ನಿಷ್ಕ್ರಿಯ = ಸ್ನೈಪರ್ ರಕ್ಷಣೆಯನ್ನು ಭೇದಿಸುತ್ತಾನೆ)."

msgid "Reveal Roles on Death:"
msgstr "ಮರಣದ ಸಮಯದಲ್ಲಿ ಪಾತ್ರಗಳನ್ನು ಬಹಿರಂಗಪಡಿಸಿ:"

msgid "0 — Secret (Closed graveyard, roles concealed until game over)"
msgstr "0 — ರಹಸ್ಯ (ಮುಚ್ಚಿದ ಸ್ಮಶಾನ, ಆಟ ಮುಗಿಯುವವರೆಗೆ ಪಾತ್ರಗಳು ಗೌಪ್ಯ)"

msgid "1 — Alignment Only (Announces \"GOOD\" vs \"EVIL\")"
msgstr "1 — ನಿಷ್ಠೆ ಮಾತ್ರ (\"ಒಳ್ಳೆಯದು\" ವಿರುದ್ಧ \"ಕೆಟ್ಟದ್ದು\" ಪ್ರಕಟಿಸುತ್ತದೆ)"

msgid "2 — Faction / Team (Announces \"Town\", \"Werewolves\", \"Neutral\")"
msgstr "2 — ಬಣ / ತಂಡ (\"ನಗರ\", \"ತೋಳಗಳು\", \"ತಟಸ್ಥ\" ಪ್ರಕಟಿಸುತ್ತದೆ)"

msgid "3 — Full Role Card (Announces exact card name and icon)"
msgstr "3 — ಸಂಪೂರ್ಣ ಪಾತ್ರ ಕಾರ್ಡ್ (ನಿಖರವಾದ ಕಾರ್ಡ್ ಹೆಸರು ಮತ್ತು ಐಕಾನ್ ಪ್ರಕಟಿಸುತ್ತದೆ)"

msgid "💡 In Limbo games, role revelation strictly occurs on permanent death (\"death death\"), never while hovering in Limbo."
msgstr "💡 ಲಿಂಬೋ ಆಟಗಳಲ್ಲಿ, ಪಾತ್ರದ ಬಹಿರಂಗಪಡಿಸುವಿಕೆ ಕೇವಲ ಶಾಶ್ವತ ಮರಣದ ನಂತರವೇ ಆಗುತ್ತದೆ, ಲಿಂಬೋದಲ್ಲಿರುವಾಗಲ್ಲ."

msgid "Starting Role Deck Preset"
msgstr "ಆರಂಭಿಕ ರೋಲ್ ಡೆಕ್ ಪ್ರಿಸೆಟ್"

msgid "🧑 Simple / Classic (No special powers — pure Wolves vs Villagers)"
msgstr "🧑 ಸರಳ / ಕ್ಲಾಸಿಕ್ (ಯಾವುದೇ ವಿಶೇಷ ಶಕ್ತಿಗಳಿಲ್ಲ — ಕೇವಲ ತೋಳಗಳು ವಿರುದ್ಧ ಗ್ರಾಮಸ್ಥರು)"

msgid "🔍 Standard (Wolves + Detective/Seer + Doctor/Guard + Villagers)"
msgstr "🔍 ಪ್ರಮಾಣಿತ (ತೋಳಗಳು + ಪತ್ತೇದಾರಿ/ದ್ರಷ್ಟಾರ + ವೈದ್ಯ/ಅಂಗರಕ್ಷಕ + ಗ್ರಾಮಸ್ಥರು)"

msgid "👼 Limbo & Angel (Wolves + Detective + Doctor + Angel + Sniper + Villagers)"
msgstr "👼 ಲಿಂಬೋ ಮತ್ತು ದೇವದೂತ (ತೋಳಗಳು + ಪತ್ತೇದಾರಿ + ವೈದ್ಯ + ದೇವದೂತ + ಸ್ನೈಪರ್ + ಗ್ರಾಮಸ್ಥರು)"

msgid "⚡ Chaos & Specials (Alpha Wolf, Silencer, Detective, Doctor, Sniper, Mayor, Witch...)"
msgstr "⚡ ಅವ್ಯವಸ್ಥೆ ಮತ್ತು ವಿಶೇಷತೆಗಳು (ಆಲ್ಫಾ ತೋಳ, ಸೈಲೆನ್ಸರ್, ಪತ್ತೇದಾರಿ, ವೈದ್ಯ, ಸ್ನೈಪರ್, ಮೇಯರ್, ಮಾಟಗಾತಿ...)"

msgid "💡 The deck adapts automatically to the number of players who join. You can fine-tune every role and good vs. bad balance live in the Pre-Game Lobby before starting."
